# Gmail SMTP: copy these settings into .env.local (do not commit credentials).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Use a Google App Password, not your normal Gmail password.
SMTP_PASS=
# Optional; defaults to SMTP_USER. Use your Gmail address or a verified alias.
EMAIL_FROM=
# Public URL used in automatically emailed demo links.
SITE_URL=https://bharatpahchan.com

# Razorpay (replace dummy/test placeholders with real keys before going live).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# Optional — only needed if you enable webhooks in Razorpay Dashboard.
# RAZORPAY_WEBHOOK_SECRET=
