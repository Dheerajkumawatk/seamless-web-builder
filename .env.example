# Gmail SMTP: copy these settings into .env.local (do not commit credentials).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Use a Google App Password, not your normal Gmail password.
SMTP_PASS=
# Optional; defaults to SMTP_USER. Use your Gmail address or a verified alias.
EMAIL_FROM=
# Public URL used in automatically emailed demo links.
SITE_URL=https://bharatpahchan.com
